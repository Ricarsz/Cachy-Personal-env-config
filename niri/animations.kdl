// Niri 动画配置文件
// 
// 动画类型：
//   1. Spring（弹簧动画）：基于物理模型，支持阻尼和回弹
//   2. Duration（时长动画）：固定时长 + 缓动曲线
//
// 缓动曲线参考：
//   设计曲线：https://easings.co/
//   预览效果：https://easings.net/

animations {
    // 禁用所有动画（性能优化或无障碍需求）
    //off

    // 全局动画速度倍率
    // < 1.0：加速；> 1.0：减速；1.0：正常速度
    slowdown 1.14514

    // ==================== 工作区切换 ====================
    workspace-switch {
        // off：单独禁用此动画
        
        // Spring 弹簧动画参数：
        // damping-ratio（阻尼比）：
        //   = 1.0：临界阻尼，无回弹（默认）
        //   < 1.0：欠阻尼，有回弹效果
        //   > 1.0：过阻尼，可能导致动画异常
        // stiffness（刚度）：
        //   数值越大，弹簧越硬，动画越生涩
        //   数值越小，弹簧越软，回弹越明显
        // epsilon（精度）：
        //   当动画速度和位移小于此值时，动画停止
        //   值越小，动画越精确，但计算开销越大
        spring damping-ratio=0.82 stiffness=400 epsilon=0.0001
    }

    // ==================== 水平视图移动 ====================
    // 左右切换焦点/移动列时的动画
    horizontal-view-movement {
        spring damping-ratio=0.84 stiffness=400 epsilon=0.0001
    }

    // ==================== 窗口打开 ====================
    // Duration 动画（已禁用，使用 Spring 替代）
    /-window-open {
        duration-ms 150
        curve "ease-out-expo"
        
        // 可用缓动曲线：
        // ease-out-quad：平缓减速，类似线性但更自然
        // ease-out-cubic：较快加速后迅速减速
        // ease-out-expo：指数级加速后瞬间减速（最流畅）
        // linear：线性动画（无加速/减速）
        // cubic-bezier：自定义贝塞尔曲线
        //   语法：curve "cubic-bezier" x1 y1 x2 y2
        //   示例：curve "cubic-bezier" 0.05 0.7 0.1 1
    }
    
    // Spring 动画（当前启用）
    window-open {
        spring damping-ratio=1.0 stiffness=2400 epsilon=0.0001
    }

    // ==================== 窗口关闭 ====================
    // Duration 动画（已禁用）
    /-window-close {
        duration-ms 150
        curve "ease-out-quad"
    }
    
    // Spring 动画（当前启用）
    // 较低的阻尼比（0.8）产生轻微回弹效果
    window-close {
        spring damping-ratio=0.8 stiffness=400 epsilon=0.0001
    }

    // ==================== 窗口移动 ====================
    // 包括：合并列、上下移动窗口、合并/踢出列等
    // 临界阻尼（1.0），高刚度（800）确保动画快速响应
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    // ==================== 窗口调整大小 ====================
    // 按预设切换宽度/高度时的动画
    // 略低的阻尼比（0.9）产生轻微弹性效果
    window-resize {
        spring damping-ratio=0.9 stiffness=500 epsilon=0.0001
    }

    // ==================== 截图界面 ====================
    // 截图 UI 打开动画（Duration 类型）
    screenshot-ui-open {
        duration-ms 300
        curve "ease-out-quad"
    }

    // ==================== 总览界面 ====================
    // Overview 打开/关闭动画
    // 临界阻尼，高刚度（900）确保快速响应
    overview-open-close {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
}

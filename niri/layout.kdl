// Niri 布局配置文件
// 控制窗口排列、间距、边框、阴影等视觉效果

layout {
    // 工作区背景颜色
    // "transparent"：透明背景
    //background-color "transparent"
    
    // 窗口间距（逻辑像素）
    // 逻辑像素会根据显示器缩放比例自动转换为物理像素
    gaps 10

    // 焦点居中策略
    // "never"：从不居中，焦点保持在屏幕边缘
    // "always"：始终居中当前聚焦的列
    // "on-overflow"：仅当列无法与前一列同时显示时居中
    center-focused-column "never"

    // 预设列宽度（Mod+R 循环切换）
    // proportion：占屏幕宽度的比例（考虑间距）
    // 例如：proportion 0.25 可以完美容纳 4 个窗口
    // fixed：固定逻辑像素宽度
    preset-column-widths {
        proportion 0.33333  // 1/3 屏幕宽度
        proportion 0.5      // 1/2 屏幕宽度
        proportion 0.66667  // 2/3 屏幕宽度
        // fixed 1920       // 固定 1920 像素
    }

    // 预设窗口高度（Mod+Shift+R 循环切换）
    // preset-window-heights { }

    // 新窗口默认宽度
    // proportion 0.5：占屏幕宽度的 50%
    default-column-width { proportion 0.5; }
    // 空括号：由应用程序自行决定初始宽度
    // default-column-width {}

    // ==================== 焦点环（Focus Ring）====================
    // 焦点环：当前聚焦窗口的高亮边框
    // 绘制在窗口背景之后，会透过半透明窗口显示
    // 如果不希望透出，可启用 prefer-no-csd 或 draw-border-with-background
    focus-ring {
        // off：禁用焦点环
        
        // 焦点环宽度（逻辑像素）
        // 从窗口边缘向外延伸的距离
        width 3

        // 颜色格式支持：
        // CSS 命名颜色："red"
        // RGB 十六进制："#rgb"、"#rgba"、"#rrggbb"、"#rrggbbaa"
        // CSS 函数："rgb(255, 127, 0)"、"rgba()"、"hsl()" 等
        
        // 活动窗口焦点环颜色（当前显示器）
        //active-color "@primary"
        //active-color "#00000000"
        
        // 非活动窗口焦点环颜色（其他显示器）
        // 焦点环仅围绕活动窗口，此颜色仅在其他显示器可见
        //inactive-color "#505050"

        // 渐变颜色（优先于纯色）
        // 语法：from="起始颜色" to="结束颜色" angle=角度
        // 角度：0=下到上，90=左到右，180=上到下（默认），270=右到左
        // 可使用 CSS linear-gradient 工具设计
        // active-gradient from="#80c8ff" to="#c7ff7f" angle=45

        // 渐变参考系
        // 默认相对于窗口自身
        // relative-to="workspace-view"：相对于整个工作区视图
        // inactive-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
    }

    // ==================== 窗口边框（Border）====================
    // 边框：始终可见的窗口边框（与焦点环类似但不隐藏）
    // 如果启用边框，建议禁用焦点环
    border {
        off  // 禁用边框
        
        width 4                    // 边框宽度
        active-color "#ffc87f"     // 活动窗口颜色
        inactive-color "#505050"   // 非活动窗口颜色
        
        // 紧急窗口颜色（请求注意力的窗口）
        urgent-color "#9b0000"

        // 渐变颜色空间
        // in="oklch longer hue"：使用 OKLCH 色彩空间的彩虹渐变
        // active-gradient from="#e5989b" to="#ffb4a2" angle=45 relative-to="workspace-view" in="oklch longer hue"
        // inactive-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
    }

    // ==================== 窗口阴影（Shadow）====================
    shadow {
        on  // 启用阴影

        // 阴影绘制模式
        // 默认仅围绕窗口绘制，不绘制在窗口背后
        // draw-behind-window=true：在窗口背后绘制阴影
        // 注意：CSD 窗口的圆角半径未知，可能导致阴影伪影
        // 启用 prefer-no-csd + geometry-corner-radius 可解决此问题
        //draw-behind-window true

        // 阴影参数（逻辑像素），对应 CSS box-shadow 属性
        
        // 柔和度：控制阴影模糊半径
        // 值越大，阴影越柔和/扩散
        softness 20
        
        // 扩展：控制阴影大小
        // 正值扩大，负值缩小
        spread 2
        
        // 偏移：阴影相对于窗口的位置
        // x>0 右移，y>0 下移
        offset x=-4 y=-4
        
        // 阴影颜色（RGBA）
        color "rgba(0, 0, 0, 0.7)"
    }

    // ==================== 边缘留白（Struts）====================
    // Struts：缩小窗口可用区域，类似层叠面板的效果
    // 可理解为"外间距"，与 gaps 类似但更靠近屏幕边缘
    // 左右 Struts 会使相邻窗口始终可见
    // 上下 Struts 会在面板和 gaps 基础上增加额外间距
    struts {
        //left 64
        // right 64
        // top 64
        // bottom 64
    }
}
